#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed
# Package name for the extra flavor.
#SHLIB_PKGS := $(shell sed -nr '/extra/! s/^Package:[[:space:]]*(lib.*[0-9]+)[[:space:]]*$$/\1/p' debian/control)

%:
	dh $@


# dh_make generated override targets
# This is example for Cmake (See https://bugs.debian.org/641051 )
# -DCMAKE_INSTALL_PREFIX=./ 
override_dh_auto_configure:
	dh_auto_configure -- \
	-DTRITON_ENABLE_GRPC=OFF \
	-DTRITON_ENABLE_HTTP=OFF \
	-DTRITON_ENABLE_GPU=OFF \
	-DTRITON_ENABLE_METRICS_GPU=OFF \
	-DTRITON_ENABLE_SERVER=ON \
	-DTRITON_ENABLE_CLIENT=OFF \
	-DTRITON_ENABLE_CC_HTTP=OFF \
	-DTRITON_ENABLE_CC_GRPC=OFF \
	-DTRITON_ENABLE_EXAMPLES=OFF \
	-DTRITON_ENABLE_TESTS=ON \
	-DTRITON_ENABLE_PYTHON_BACKEND=ON \
	-DTRITON_ENABLE_ENSEMBLE=ON \
	-DCMAKE_LIBRARY_ARCHITECTURE=$(DEB_HOST_MULTIARCH)

#override_dh_auto_build:
#	cd obj-x86_64-linux-gnu && make -j16 "INSTALL=install --strip-program=true" VERBOSE=1

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info
